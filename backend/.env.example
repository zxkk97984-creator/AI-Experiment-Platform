DAI_APP_NAME=DAI Experiment Platform API
DAI_ENVIRONMENT=development
DAI_DATABASE_URL=mysql+pymysql://dai:dai_password@localhost:3306/dai_platform
DAI_REDIS_URL=redis://localhost:6379/0
DAI_SECRET_KEY=replace-with-a-long-random-secret
DAI_ACCESS_TOKEN_EXPIRE_MINUTES=30
DAI_REFRESH_TOKEN_EXPIRE_DAYS=7
DAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File storage: development uses the existing local storage directories.
DAI_STORAGE_BACKEND=local
# Shared private materials: ordinary files 100 MiB, video/ZIP 500 MiB.
DAI_MATERIAL_MAX_UPLOAD_BYTES=104857600
DAI_MATERIAL_LARGE_MAX_UPLOAD_BYTES=524288000
DAI_MATERIAL_URL_TTL_SECONDS=900
# DAI_MATERIAL_STORAGE_DIR=storage/materials
# S3-compatible deployments can switch the backend without changing business
# services or database object keys. Leave these commented for local development.
# DAI_STORAGE_BACKEND=s3
# DAI_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
# DAI_STORAGE_S3_BUCKET=dai-platform
# DAI_STORAGE_S3_REGION=us-east-1
# DAI_STORAGE_S3_ACCESS_KEY_ID=
# DAI_STORAGE_S3_SECRET_ACCESS_KEY=
# DAI_STORAGE_S3_SESSION_TOKEN=
# DAI_STORAGE_S3_ADDRESSING_STYLE=path
# DAI_STORAGE_S3_KEY_PREFIX=
DAI_JUPYTER_BASE_URL=http://localhost:8888
DAI_JUDGE_QUEUE_NAME=judge:queue
DAI_JUDGE_IMAGE=dai-judge-python:latest
DAI_JUDGE_USE_DOCKER=true
DAI_JUDGE_TIMEOUT_SECONDS=10
DAI_JUDGE_MEMORY_LIMIT_MB=256
DAI_JUDGE_CPU_LIMIT=1

# AI 智能代码评分（DeepSeek）
DAI_AI_ENABLED=true
DAI_AI_BASE_URL=https://aihub.codingpython.cn
DAI_AI_API_KEY=
DAI_AI_MODEL=deepseek-v4-flash
DAI_AI_TIMEOUT_SECONDS=60
DAI_AI_MAX_RETRIES=3
DAI_AI_TEST_GROUP_TIMEOUT_SECONDS=120
DAI_AI_TEST_GROUP_MAX_RETRIES=0
DAI_AI_QUEUE_NAME=judge:ai:queue

# 文件日志（管理员系统日志页读取；置空 DAI_LOG_DIR 禁用）
DAI_LOG_DIR=logs
DAI_LOG_MAX_BYTES=20971520
DAI_LOG_BACKUP_COUNT=10

# Student account management: independent Fernet keys, newest key first for rotation.
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep outside Git and separate from DAI_SECRET_KEY; preserve old keys until ciphertext is rotated.
DAI_ACCOUNT_SECURITY_KEYS=
DAI_ACCOUNT_WORKER_HASH_CONCURRENCY=2
DAI_ACCOUNT_BATCH_RETENTION_DAYS=90
DAI_ACCOUNT_AUDIT_RETENTION_DAYS=365
DAI_ACCOUNT_CREDENTIAL_EXPORT_HOURS=24

# Lab jobs: budgets exclude the API/database and existing judge/builder processes.
DAI_LAB_ENABLED=true
DAI_LAB_TRAINING_CONCURRENCY=1
DAI_LAB_TOTAL_CPUS=4
DAI_LAB_TOTAL_MEMORY_MB=8192
DAI_LAB_INTERACTIVE_RESERVED_MEMORY_MB=2048
DAI_LAB_MAX_KERNELS=20
DAI_LAB_GPU_ENABLED=false
DAI_LAB_GPU_DEVICES=
DAI_LAB_UPLOAD_MAX_BYTES=524288000
DAI_LAB_EXPANDED_MAX_BYTES=2147483648
DAI_LAB_ARTIFACT_QUOTA_BYTES=2147483648
DAI_LAB_MIN_FREE_DISK_MB=2048
